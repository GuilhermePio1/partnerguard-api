# Copy to .env to override the local defaults used by docker-compose.yml and the app.
# Local development only. Never put real credentials here; .env is git-ignored.
POSTGRES_PORT=5432
POSTGRES_USER=partnerguard
POSTGRES_PASSWORD=partnerguard-local
APP_DB_USER=partnerguard_app
APP_DB_PASSWORD=partnerguard-app-local
KEYCLOAK_ADMIN_USER=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-local
