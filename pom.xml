<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.partnerguard</groupId>
    <artifactId>partnerguard-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>PartnerGuard API</name>
    <description>Secure REST API for insurance policies and partner repair shops</description>

    <properties>
        <java.version>21</java.version>
        <openapi-generator.version>7.25.0</openapi-generator.version>
        <springdoc.version>3.1.1</springdoc.version>
        <archunit.version>1.5.1</archunit.version>
        <bucket4j.version>8.20.0</bucket4j.version>

        <!--
          Security overrides of versions managed by Spring Boot. Remove each one as soon as
          Boot manages a fixed version; `./mvnw dependency:tree` shows what is resolved.
          Procedure (fix and post-upgrade cleanup): .claude/skills/dependency-cve.
        -->
        <!-- CVE-2026-19880 (logback-classic path traversal, fixed in 1.6.3). Boot 4.1.1 manages 1.5.38. -->
        <logback.version>1.6.4</logback.version>
        <!-- Aligned with logback 1.6.4, which is built against slf4j 2.0.19 (Boot 4.1.1 manages 2.0.18). -->
        <slf4j.version>2.0.19</slf4j.version>
        <!--
          Tomcat CVEs fixed in 11.0.25 / 11.0.26, among them CVE-2026-65637, CVE-2026-65905,
          CVE-2026-65182, CVE-2026-68525, CVE-2026-86350 and CVE-2026-77762. Boot 4.1.1 manages 11.0.24.
        -->
        <tomcat.version>11.0.26</tomcat.version>
        <!--
          jackson-databind CVE-2026-68497, CVE-2026-83557, CVE-2026-19032 (fixed in 3.1.6) and
          CVE-2026-91776, CVE-2026-91777 (fixed in 3.1.7). Patch release of the line Boot 4.1.1 manages (3.1.5).
        -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <!--
          Jackson 2 (used by springdoc's swagger-core): same five CVEs, fixed in 2.21.6 / 2.21.7.
          Patch release of the line Boot 4.1.1 manages (2.21.5).
        -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- pgjdbc CVE-2026-107314 and CVE-2026-107315, fixed in 42.7.14 (security-only release). Boot 4.1.1 manages 42.7.13. -->
        <postgresql.version>42.7.14</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- JWT resource server (ADR-0002). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Rate limiting (ADR-0006): token buckets, held in a bounded in-memory cache. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Only spring-boot:run is local; a packaged jar never enables the local profile. -->
                    <profiles>
                        <profile>local</profile>
                    </profiles>
                </configuration>
            </plugin>

            <!-- Contract-first (ADR-0007): API interfaces and DTOs come from contracts/openapi.yaml. -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>partnerguard-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/contracts/openapi.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <apiPackage>com.partnerguard.api</apiPackage>
                            <modelPackage>com.partnerguard.api.model</modelPackage>
                            <!-- PartnerDto, ClaimStatusDto...: keeps contract types apart from domain entities. -->
                            <modelNameSuffix>Dto</modelNameSuffix>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot4>true</useSpringBoot4>
                                <useJackson3>true</useJackson3>
                                <useBeanValidation>true</useBeanValidation>
                                <performBeanValidation>false</performBeanValidation>
                                <!-- No class-level @Validated: Spring MVC's built-in method validation only. -->
                                <useSpringBuiltInValidation>true</useSpringBuiltInValidation>
                                <useTags>true</useTags>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <openApiNullable>false</openApiNullable>
                                <!-- Swagger annotations let springdoc reproduce every documented status (DOC-01). -->
                                <documentationProvider>springdoc</documentationProvider>
                                <annotationLibrary>swagger2</annotationLibrary>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <useResponseEntity>true</useResponseEntity>
                                <dateLibrary>java8</dateLibrary>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
